{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://urbino.invalid/schema/urbino.json",
  "title": "Urbino configuration",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "environment": {"enum": ["development", "production"]},
    "server": {"$ref": "#/$defs/server"},
    "database": {"$ref": "#/$defs/connection"},
    "valkey": {"$ref": "#/$defs/connection"},
    "secrets": {"type":"object", "additionalProperties":false, "properties":{"kms_ref":{"type":"string"},"directory":{"type":"string"}}},
    "transport": {"type":"object", "additionalProperties":false, "properties":{"provider_allowlist":{"type":"array","items":{"type":"string"}},"tls_verify":{"type":"boolean"},"proxy_url":{"type":"string"}}},
    "security": {"type":"object", "additionalProperties":false, "properties":{"test_mode":{"type":"boolean"},"pprof":{"type":"boolean"},"admin_public":{"type":"boolean"}}},
    "limits": {"type":"object", "additionalProperties":false, "properties":{"max_body_bytes":{"type":"integer","minimum":0},"max_stream_bytes":{"type":"integer","minimum":0},"max_concurrency":{"type":"integer","minimum":0}}},
    "billing": {"type":"object", "additionalProperties":false, "properties":{"mode":{"type":"string"},"currency":{"type":"string"}}},
    "jobs": {"type":"object", "additionalProperties":false, "properties":{"enabled":{"type":"boolean"},"drain_timeout":{"type":"string"}}},
    "observability": {"type":"object", "additionalProperties":false, "properties":{"log_level":{"type":"string"},"service_name":{"type":"string"}}},
    "retention": {"type":"object", "additionalProperties":false, "properties":{"request_days":{"type":"integer","minimum":0},"usage_days":{"type":"integer","minimum":0}}}
  },
  "$defs": {
    "listener": {"type":"object","additionalProperties":false,"properties":{"listen":{"type":"string"},"enabled":{"type":"boolean"}}},
    "server": {"type":"object","additionalProperties":false,"properties":{"public":{"$ref":"#/$defs/listener"},"admin":{"$ref":"#/$defs/listener"},"internal":{"$ref":"#/$defs/listener"}}},
    "connection": {"type":"object","additionalProperties":false,"properties":{"url_file":{"type":"string"},"url":{"type":"string"}}}
  }
}
