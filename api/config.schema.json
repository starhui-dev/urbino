{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/urbino/config.schema.json",
  "title": "Urbino startup configuration",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "health_addr": {"type": "string", "minLength": 1},
    "public_addr": {"type": "string", "minLength": 1},
    "admin_addr": {"type": "string", "minLength": 1},
    "auth_pepper_file": {"type": "string", "minLength": 1},
    "environment": {"type": "string", "enum": ["development", "test", "production"]},
    "log_level": {"type": "string", "enum": ["debug", "info", "warn", "error"]},
    "development": {"type": "boolean", "default": false},
    "database": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dsn_file": {"type": "string", "minLength": 1}
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["environment"],
        "properties": {"environment": {"const": "production"}}
      },
      "then": {"properties": {"development": {"const": false}}}
    }
  ],
  "x-urbino-environment": {
    "URBINO_CONFIG": "selected startup file; --config has higher precedence",
    "URBINO_HEALTH_ADDR": "health_addr",
    "URBINO_PUBLIC_ADDR": "public_addr",
    "URBINO_ADMIN_ADDR": "admin_addr",
    "URBINO_AUTH_PEPPER_FILE": "auth_pepper_file",
    "URBINO_LOG_LEVEL": "log_level",
    "URBINO_ENV": "environment",
    "URBINO_DATABASE_DSN_FILE": "database.dsn_file"
  }
}
